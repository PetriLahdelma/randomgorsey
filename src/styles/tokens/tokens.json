{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "org.randomgorsey.contract": {
      "version": "2025.10",
      "scope": "component-library",
      "description": "Cold industrial productive-UI tokens. The expressive artist shell remains owned by --studio-* tokens."
    }
  },
  "ds": {
    "color": {
      "$type": "color",
      "neutral": {
        "0": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
        "50": { "$value": { "colorSpace": "srgb", "components": [0.941176, 0.941176, 0.901961], "hex": "#f0f0e6" } },
        "100": { "$value": { "colorSpace": "srgb", "components": [0.847059, 0.85098, 0.823529], "hex": "#d8d9d2" } },
        "400": { "$value": { "colorSpace": "srgb", "components": [0.647059, 0.666667, 0.627451], "hex": "#a5aaa0" } },
        "600": { "$value": { "colorSpace": "srgb", "components": [0.313725, 0.329412, 0.301961], "hex": "#50544d" } },
        "750": { "$value": { "colorSpace": "srgb", "components": [0.180392, 0.196078, 0.180392], "hex": "#2e322e" } },
        "850": { "$value": { "colorSpace": "srgb", "components": [0.109804, 0.121569, 0.109804], "hex": "#1c1f1c" } },
        "950": { "$value": { "colorSpace": "srgb", "components": [0.062745, 0.070588, 0.062745], "hex": "#101210" } },
        "1000": { "$value": { "colorSpace": "srgb", "components": [0.066667, 0.078431, 0.058824], "hex": "#11140f" } }
      },
      "signal": {
        "blue": { "$value": { "colorSpace": "srgb", "components": [0.137255, 0.294118, 0.87451], "hex": "#234bdf" } },
        "acid": { "$value": { "colorSpace": "srgb", "components": [0.843137, 1, 0.266667], "hex": "#d7ff44" } }
      },
      "support": {
        "error": { "$value": { "colorSpace": "srgb", "components": [0.776471, 0.25098, 0.25098], "hex": "#c64040" } },
        "success": { "$value": { "colorSpace": "srgb", "components": [0.129412, 0.478431, 0.294118], "hex": "#217a4b" } },
        "warning": { "$value": { "colorSpace": "srgb", "components": [0.721569, 0.360784, 0], "hex": "#b85c00" } }
      }
    },
    "space": {
      "$type": "dimension",
      "0": { "$value": { "value": 0, "unit": "px" } },
      "1": { "$value": { "value": 4, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } },
      "5": { "$value": { "value": 20, "unit": "px" } },
      "6": { "$value": { "value": 24, "unit": "px" } },
      "8": { "$value": { "value": 32, "unit": "px" } },
      "10": { "$value": { "value": 40, "unit": "px" } },
      "12": { "$value": { "value": 48, "unit": "px" } }
    },
    "size": {
      "$type": "dimension",
      "control": {
        "compact": { "$value": { "value": 32, "unit": "px" } },
        "default": { "$value": { "value": 40, "unit": "px" } },
        "large": { "$value": { "value": 48, "unit": "px" } },
        "touch": { "$value": { "value": 44, "unit": "px" } }
      },
      "content": {
        "dialog": { "$value": { "value": 640, "unit": "px" } }
      }
    },
    "border": {
      "width": {
        "$type": "dimension",
        "hairline": { "$value": { "value": 1, "unit": "px" } },
        "strong": { "$value": { "value": 2, "unit": "px" } },
        "focus": { "$value": { "value": 3, "unit": "px" } }
      },
      "radius": {
        "$type": "dimension",
        "none": { "$value": { "value": 0, "unit": "px" } }
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "sans": { "$value": ["Europa", "Arial", "sans-serif"] },
        "mono": { "$value": ["GeistPixelSquare", "Geist Mono", "ui-monospace", "monospace"] },
        "terminal": { "$value": ["lisaterminal", "GeistPixelSquare", "monospace"] }
      },
      "size": {
        "$type": "dimension",
        "meta": { "$value": { "value": 12, "unit": "px" } },
        "control": { "$value": { "value": 15, "unit": "px" } },
        "body": { "$value": { "value": 17, "unit": "px" } },
        "title": { "$value": { "value": 18, "unit": "px" } }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium": { "$value": 500 },
        "bold": { "$value": 700 }
      },
      "tracking": {
        "$type": "dimension",
        "meta": { "$value": { "value": 0.24, "unit": "px" } },
        "wide": { "$value": { "value": 0.72, "unit": "px" } }
      }
    },
    "motion": {
      "duration": {
        "$type": "duration",
        "press": { "$value": { "value": 100, "unit": "ms" } },
        "exit": { "$value": { "value": 160, "unit": "ms" } },
        "enter": { "$value": { "value": 200, "unit": "ms" } }
      },
      "ease": {
        "$type": "cubicBezier",
        "out": { "$value": [0.16, 1, 0.3, 1] },
        "inOut": { "$value": [0.65, 0, 0.35, 1] }
      }
    }
  },
  "component": {
    "surface": {
      "$type": "color",
      "canvas": { "$value": "{ds.color.neutral.950}" },
      "layer": { "$value": "{ds.color.neutral.850}" },
      "panel": { "$value": "{ds.color.neutral.100}" },
      "field": { "$value": "{ds.color.neutral.50}" }
    },
    "text": {
      "$type": "color",
      "primary": { "$value": "{ds.color.neutral.1000}" },
      "secondary": { "$value": "{ds.color.neutral.600}" },
      "onDark": { "$value": "{ds.color.neutral.50}" }
    },
    "control": {
      "height": {
        "$type": "dimension",
        "compact": { "$value": "{ds.size.control.compact}" },
        "default": { "$value": "{ds.size.control.default}" },
        "large": { "$value": "{ds.size.control.large}" }
      },
      "background": { "$type": "color", "$value": "{ds.color.neutral.50}" },
      "backgroundHover": { "$type": "color", "$value": "{ds.color.neutral.100}" },
      "text": { "$type": "color", "$value": "{ds.color.neutral.1000}" },
      "border": { "$type": "color", "$value": "{ds.color.neutral.600}" },
      "borderStrong": { "$type": "color", "$value": "{ds.color.neutral.1000}" },
      "focus": { "$type": "color", "$value": "{ds.color.signal.blue}" },
      "focusOnDark": { "$type": "color", "$value": "{ds.color.signal.acid}" },
      "focusOffset": { "$type": "dimension", "$value": "{ds.space.1}" }
    },
    "button": {
      "primary": {
        "background": { "$type": "color", "$value": "{ds.color.signal.acid}" },
        "text": { "$type": "color", "$value": "{ds.color.neutral.1000}" },
        "hover": { "$type": "color", "$value": "{ds.color.neutral.0}" }
      },
      "secondary": {
        "background": { "$type": "color", "$value": "{ds.color.neutral.50}" },
        "text": { "$type": "color", "$value": "{ds.color.neutral.1000}" },
        "border": { "$type": "color", "$value": "{ds.color.neutral.600}" },
        "hover": { "$type": "color", "$value": "{ds.color.neutral.100}" }
      }
    },
    "status": {
      "info": {
        "background": { "$type": "color", "$value": "{ds.color.signal.blue}" },
        "text": { "$type": "color", "$value": "{ds.color.neutral.0}" },
        "border": { "$type": "color", "$value": "{ds.color.signal.blue}" }
      },
      "success": {
        "background": { "$type": "color", "$value": "{ds.color.support.success}" },
        "text": { "$type": "color", "$value": "{ds.color.neutral.0}" },
        "border": { "$type": "color", "$value": "{ds.color.support.success}" }
      },
      "warning": {
        "background": { "$type": "color", "$value": "{ds.color.support.warning}" },
        "text": { "$type": "color", "$value": "{ds.color.neutral.0}" },
        "border": { "$type": "color", "$value": "{ds.color.support.warning}" }
      },
      "error": {
        "background": { "$type": "color", "$value": "{ds.color.support.error}" },
        "text": { "$type": "color", "$value": "{ds.color.neutral.0}" },
        "border": { "$type": "color", "$value": "{ds.color.support.error}" }
      }
    }
  }
}
