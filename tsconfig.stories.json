{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": ["node", "react", "react-dom", "vitest/globals"]
  },
  "include": [
    "next-env.d.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "src/stories/studio/**/*.ts",
    "src/stories/studio/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "storybook-static",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**",
    "src/setupTests.ts"
  ]
}
